#!/bin/bash
#
# Pre-push hook for monitor-agent
#
# Runs the same lint + test + coverage gates that CI runs, locally, before any
# push reaches origin. If this passes, CI should pass too — literally: both
# invoke the same just recipes.
#
# Install: `just install-hooks`
#
# PIPELINE PARITY: this hook mirrors .github/workflows/ci.yml, which invokes
# the SAME just recipes rather than restating the command strings:
#   `just check`  -> ci.yml job `gate`     (fmt-check + lint + test + test-features)
#   `just cov-ci` -> ci.yml job `coverage` (77% line floor)
# The justfile is the single source of truth for both.
#
# CI differs in exactly two documented ways, both listed in ci.yml's header:
# it apt-installs libasound2-dev + pkg-config, and it uploads lcov.info.
# CI additionally runs an `msrv` job (a second full toolchain) that this hook
# deliberately skips — it is wall-clock a developer should not pay per push.
#
# NOTE: the coverage floor is calibrated on a CI RUNNER, not here. This box
# reads ~0.4 points high because voice.rs probes for TTS binaries that are
# installed locally and absent on a runner. See the justfile for detail.
#
# When editing this hook, update the workflow to match, and vice versa.
#
# Do NOT skip this hook with `--no-verify`. Fix the issue instead.

set -e

# Ensure ~/.cargo/bin is on PATH so cargo-installed tools are found
# even when the hook is invoked from a GUI git client or minimal shell.
export PATH="$HOME/.cargo/bin:$PATH"

cd "$(git rev-parse --show-toplevel)"

if ! command -v just >/dev/null 2>&1; then
    echo "pre-push: 'just' not found in PATH"
    echo "          install via: cargo install just"
    exit 1
fi

if ! command -v cargo-llvm-cov >/dev/null 2>&1; then
    echo "pre-push: 'cargo-llvm-cov' not found in PATH"
    echo "          install via: cargo install cargo-llvm-cov"
    exit 1
fi

echo "[pre-push] running just check..."
just check

echo "[pre-push] running just cov-ci (77% floor)..."
# On macOS (Homebrew Rust) llvm-tools-preview is unavailable via rustup, so
# cargo-llvm-cov needs to be pointed at Homebrew's LLVM. Only do that when it
# is actually there: these paths do not exist on Linux, and setting them
# unconditionally made the coverage gate fail with "could not execute process
# ... No such file or directory" on every non-Mac box — which is how the gate
# stopped gating without anyone noticing. On Linux, rustup's llvm-tools are
# found without help.
if [ -x /opt/homebrew/opt/llvm/bin/llvm-profdata ]; then
    export LLVM_COV=/opt/homebrew/opt/llvm/bin/llvm-cov
    export LLVM_PROFDATA=/opt/homebrew/opt/llvm/bin/llvm-profdata
fi
just cov-ci

echo "[pre-push] OK"
